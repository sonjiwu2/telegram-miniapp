# PostgreSQL
DATABASE_URL="postgresql://reshala:reshala@localhost:5432/reshala"

# Публичный URL приложения (используется для share-ссылок, deep links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telegram Bot — токен из @BotFather, обязателен для валидации initData
TELEGRAM_BOT_TOKEN=
# Username бота без @ — нужен для startapp deep links (Этап 7), не секрет
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Секрет для подписи сессионной cookie. Не короче 32 символов, только случайная строка.
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET=

# Dev auth bypass — ТОЛЬКО для локальной разработки.
# Физически запрещён при NODE_ENV=production (см. src/config/env.ts).
ALLOW_DEV_AUTH=false
DEV_TELEGRAM_USER_ID=

# AI Вердикт (Этап 11) — опционально: без этих переменных режим просто
# выключен (503 AI_NOT_CONFIGURED), остальное приложение не требует AI.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5
