# PostgreSQL
DATABASE_URL="postgresql://reshala:reshala@localhost:5432/reshala"

# Публичный URL приложения (используется для share-ссылок, deep links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telegram Bot (появится на Этапе 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Dev auth bypass — ТОЛЬКО для локальной разработки.
# Физически запрещён при NODE_ENV=production (см. src/config/env.ts).
ALLOW_DEV_AUTH=false
DEV_TELEGRAM_USER_ID=

# AI provider (появится на Этапе 11)
AI_PROVIDER=
AI_API_KEY=
