generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  telegramId   BigInt   @unique
  firstName    String
  lastName     String?
  username     String?
  photoUrl     String?
  languageCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdSessions Session[]            @relation("SessionCreator")
  participations  SessionParticipant[]
  ownedCompanies  Company[]            @relation("CompanyOwner")
  companyMembers  CompanyMember[]

  @@index([username])
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

model Company {
  id      String  @id @default(cuid())
  name    String
  emoji   String?

  ownerId String
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())

  members  CompanyMember[]
  sessions Session[]

  @@index([ownerId])
}

model CompanyMember {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  role      CompanyRole @default(MEMBER)
  nickname  String?

  joinedAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

// Vote (для голосований) появится на Этапе 9.

enum SessionType {
  ROULETTE
  RANDOM_CHOICE
  DEBATE
  POLL
  AI_VERDICT
}

enum SessionStatus {
  DRAFT
  OPEN
  CLOSED
  RESOLVED
  CANCELLED
}

model Session {
  id        String        @id @default(cuid())
  publicId  String        @unique @default(cuid())
  type      SessionType
  status    SessionStatus @default(DRAFT)
  title     String
  settings  Json          @default("{}")

  creatorId String
  creator   User   @relation("SessionCreator", fields: [creatorId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  participants SessionParticipant[]
  options      Option[]
  result       Result?

  createdAt DateTime  @default(now())
  startedAt DateTime?
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([companyId])
}

model SessionParticipant {
  id          String  @id @default(cuid())
  sessionId   String
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // null — участник добавлен вручную, без Telegram-аккаунта.
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])
  displayName String

  joinedAt DateTime @default(now())

  wonResults Result[] @relation("ResultWinner")

  @@unique([sessionId, userId])
  @@index([sessionId])
}

// Вариант выбора для "Нам похуй" (RANDOM_CHOICE) — не человек, а пункт списка.
model Option {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  label     String

  createdAt DateTime @default(now())

  wonResults Result[] @relation("ResultWinnerOption")

  @@index([sessionId])
}

model Result {
  id        String   @id @default(cuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  winnerParticipantId String?
  winnerParticipant   SessionParticipant? @relation("ResultWinner", fields: [winnerParticipantId], references: [id])

  winnerOptionId String?
  winnerOption   Option? @relation("ResultWinnerOption", fields: [winnerOptionId], references: [id])

  // Динамические данные конкретного режима (например, полный текст AI-вердикта).
  payload Json @default("{}")

  createdAt DateTime @default(now())
}
