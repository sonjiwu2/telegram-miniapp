generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Session domain (Company, Session, Vote, ...) появится на Этапе 4.
model User {
  id           String   @id @default(cuid())
  telegramId   BigInt   @unique
  firstName    String
  lastName     String?
  username     String?
  photoUrl     String?
  languageCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([username])
}
